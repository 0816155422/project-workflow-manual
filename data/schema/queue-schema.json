{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Pending Queue Item","type":"object","required":["id","sourcePath","status"],
  "properties":{
    "id":{"type":"string"},"sourcePath":{"type":"string","pattern":"^pending/"},
